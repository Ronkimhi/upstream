+    def test_fail_audit_superseded_by_author_correction_does_not_block(self):
+        """A FAIL audit lists defects for the author to fix; the fix is a later material
+        change to the sampled content and must be committable (backlog bucket
+        universe-audit-unexaminable-open-links, three blocked corrections by 2026-09-06).
+        A FAIL audit with no later material change is still held to currency, and a PASS
+        audit followed by a material change still fails (REV-20260830-01 attack)."""
+        current = self.mapping()
+        current["status"] = "ACTIVE"
+        current["audit"]["status"] = "FAIL"
+        current["audit"]["audited_at"] = "2026-08-30T03:00:00Z"
+        current["audit"]["role_conflicts"] = ["placements[0].role is stale"]
+        current["audit"]["amendments_required"] = ["Rewrite placements[0].role"]
+        current["audit"]["mapping_fingerprint"] = check_map.mapping_fingerprint(current)
+        self.assertEqual(self.failures(current), [])
+        stale = copy.deepcopy(current)
+        stale["placements"][0]["role"] = "Changed without any changelog entry"
+        self.assertTrue(
+            any("does not match current material content" in item
+                for item in self.failures(stale)),
+            "a FAIL audit with no later material amendment must still be current",
+        )
+        corrected = copy.deepcopy(current)
+        corrected["placements"][0]["role"] = "Corrected role, as the FAIL audit required"
+        corrected["changelog"].append({
+            "ts": "2026-08-30T04:00:00Z",
+            "by": "atlas-cartographer",
+            "kind": "AMEND",
+            "change": "run universe correcting the FAIL audit's amendments_required.",
+            "prior": "Stale role wording.",
+        })
+        self.assertEqual(self.failures(corrected), [])
+        still_pass = copy.deepcopy(corrected)
+        still_pass["status"] = "COMPLETE"
+        still_pass["audit"]["status"] = "PASS"
+        still_pass["audit"]["role_conflicts"] = []
+        still_pass["audit"]["amendments_required"] = []
+        self.assertTrue(
+            any("earlier than material mapping changelog" in item
+                for item in self.failures(still_pass)),
+            "a PASS audit followed by a material amendment must still fail",
+        )
+
