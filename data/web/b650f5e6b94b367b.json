 "text_sha256": "a48c7df6dbedd4da6d6aa862c788163fec0dd1b3e22d60fe9e0ff1c2abd2b0ae",
 "text": "\u94c1\u5efa\u91cd\u5de5\uff1a2026\u5e74\u4e00\u5b63\u5ea6\u51c0\u5229\u6da62.48\u4ebf\u5143 _ \u4e1c\u65b9\u8d22\u5bcc\u7f51 \u8d22\u7ecf \u7126\u70b9 \u80a1\u7968 \u65b0\u80a1 \u671f\u6307 \u671f\u6743 \u884c\u60c5 \u6570\u636e \u5168\u7403 \u7f8e\u80a1 \u6e2f\u80a1 \u671f\u8d27 \u5916\u6c47 \u94f6\u884c \u57fa\u91d1 \u7406\u8d22 \u503a\u5238 \u76f4\u64ad \u80a1\u5427 \u57fa\u91d1\u5427 \u535a\u5ba2 \u8d22\u5bcc\u53f7 \u641c\u7d22 \u884c\u60c5\u4e2d\u5fc3 \u6307\u6570 \u671f\u6307 \u671f\u6743 \u4e2a\u80a1 \u677f\u5757 \u6392\u884c \u65b0\u80a1 \u57fa\u91d1 \u6e2f\u80a1 \u7f8e\u80a1 \u671f\u8d27 \u5916\u6c47 \u9ec4\u91d1 \u81ea\u9009\u80a1 \u81ea\u9009\u57fa\u91d1 \u6570\u636e\u4e2d\u5fc3 \u8d44\u91d1\u6d41\u5411 \u4e3b\u529b\u6392\u540d \u677f\u5757\u8d44\u91d1 \u4e2a\u80a1\u7814\u62a5 \u65b0\u80a1\u7533\u8d2d \u8f6c\u503a\u7533\u8d2d \u5317\u4ea4\u6240\u7533\u8d2d AH\u80a1\u6bd4\u4ef7 \u5e74\u62a5\u5927\u5168 \u878d\u8d44\u878d\u5238 \u9f99\u864e\u699c \u9650\u552e\u89e3\u7981 IPO\u5ba1\u6838 \u5927\u5b97\u4ea4\u6613 \u4f30\u503c\u5206\u6790 \u9996\u9875 > \u8d22\u7ecf\u9891\u9053 > \u6b63\u6587 \u94c1\u5efa\u91cd\u5de5\uff1a2026\u5e74\u4e00\u5b63\u5ea6\u51c0\u5229\u6da62.48\u4ebf\u5143 2026\u5e7405\u670801\u65e5 22:42 \u4f5c\u8005\uff1a \u738b\u535a \u6765\u6e90\uff1a \u4e2d\u56fd\u8bc1\u5238\u62a5\u00b7\u4e2d\u8bc1\u7f51 \u5c0f \u4e2d \u5927 --> --> \u4e1c\u65b9\u8d22\u5bccAPP \u65b9\u4fbf\uff0c\u5feb\u6377 \u624b\u673a\u67e5\u770b\u8d22\u7ecf\u5feb\u8baf \u4e13\u4e1a\uff0c\u4e30\u5bcc \u4e00\u624b\u638c\u63e1\u5e02\u573a\u8109\u640f \u624b\u673a\u4e0a\u9605\u8bfb\u6587\u7ae0 \u63d0\u793a\uff1a \u5fae\u4fe1\u626b\u4e00\u626b \u5206\u4eab\u5230\u60a8\u7684 \u670b\u53cb\u5708 \u4e2d\u8bc1\u667a\u80fd\u8d22\u8baf \u94c1\u5efa\u91cd\u5de5 \uff08688425\uff094\u670829\u65e5\u62ab\u97322026\u5e74\u7b2c\u4e00\u5b63\u5ea6\u62a5\u544a\u3002\u516c\u53f8\u5b9e\u73b0\u8425\u4e1a\u603b\u6536\u516521.9\u4ebf\u5143\uff0c\u540c\u6bd4\u4e0b\u964d7.07%\uff1b\u5f52\u6bcd\u51c0\u5229\u6da62.48\u4ebf\u5143\uff0c\u540c\u6bd4\u4e0b\u964d25.24%\uff1b\u6263\u975e\u51c0\u5229\u6da62.25\u4ebf\u5143\uff0c\u540c\u6bd4\u4e0b\u964d28.54%\uff1b\u7ecf\u8425\u6d3b\u52a8\u4ea7\u751f\u7684\u73b0\u91d1\u6d41\u91cf\u51c0\u989d\u4e3a-1.61\u4ebf\u5143\uff0c\u4e0a\u5e74\u540c\u671f\u4e3a4456.45\u4e07\u5143\uff1b\u62a5\u544a\u671f\u5185\uff0c \u94c1\u5efa\u91cd\u5de5 \u57fa\u672c\u6bcf\u80a1\u6536\u76ca\u4e3a0.05\u5143\uff0c\u52a0\u6743\u5e73\u5747\u51c0\u8d44\u4ea7\u6536\u76ca\u7387\u4e3a1.33%\u3002 \u4ee54\u670829\u65e5\u6536\u76d8\u4ef7\u8ba1\u7b97\uff0c \u94c1\u5efa\u91cd\u5de5 \u76ee\u524d\u5e02\u76c8\u7387\uff08TTM\uff09\u7ea6\u4e3a18.18\u500d\uff0c\u5e02\u51c0\u7387\uff08LF\uff09\u7ea61.35\u500d\uff0c\u5e02\u9500\u7387\uff08TTM\uff09\u7ea62.58\u500d\u3002 \u76c8\u5229\u80fd\u529b\u65b9\u9762\uff0c 2026\u5e74\u4e00\u5b63\u5ea6\u516c\u53f8\u52a0\u6743\u5e73\u5747\u51c0\u8d44\u4ea7\u6536\u76ca\u7387\u4e3a1.33%\uff0c\u540c\u6bd4\u4e0b\u964d0.54\u4e2a\u767e\u5206\u70b9\u3002\u516c\u53f82026\u5e74\u7b2c\u4e00\u5b63\u5ea6\u6295\u5165\u8d44\u672c\u56de\u62a5\u7387\u4e3a1.25%\uff0c\u8f83\u4e0a\u5e74\u540c\u671f\u4e0b\u964d0.46\u4e2a\u767e\u5206\u70b9\u3002 \u622a\u81f32026\u5e74\u4e00\u5b63\u5ea6\u672b\uff0c\u516c\u53f8\u7ecf\u8425\u6d3b\u52a8\u73b0\u91d1\u6d41\u51c0\u989d\u4e3a-1.61\u4ebf\u5143\uff0c\u540c\u6bd4\u51cf\u5c112.06\u4ebf\u5143\uff1b\u7b79\u8d44\u6d3b\u52a8\u73b0\u91d1\u6d41\u51c0\u989d-1814.8\u4e07\u5143\uff0c\u540c\u6bd4\u51cf\u5c112421.7\u4e07\u5143\uff1b\u6295\u8d44\u6d3b\u52a8\u73b0\u91d1\u6d41\u51c0\u989d-5005.16\u4e07\u5143\uff0c\u4e0a\u5e74\u540c\u671f\u4e3a-1277\u4e07\u5143\u3002 \u8d44\u4ea7\u91cd\u5927\u53d8\u5316\u65b9\u9762\uff0c\u622a\u81f32026\u5e74\u4e00\u5b63\u5ea6\u672b\uff0c\u516c\u53f8\u5e94\u6536\u7968\u636e\u53ca\u5e94\u6536\u8d26\u6b3e\u8f83\u4e0a\u5e74\u672b\u589e\u52a03.43%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0a\u53471.07\u4e2a\u767e\u5206\u70b9\uff1b\u56fa\u5b9a\u8d44\u4ea7\u8f83\u4e0a\u5e74\u672b\u51cf\u5c112.77%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0b\u964d0.68\u4e2a\u767e\u5206\u70b9\uff1b\u8d27\u5e01\u8d44\u91d1\u8f83\u4e0a\u5e74\u672b\u51cf\u5c116.86%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0b\u964d0.61\u4e2a\u767e\u5206\u70b9\uff1b\u5176\u4ed6\u6d41\u52a8\u8d44\u4ea7\u8f83\u4e0a\u5e74\u672b\u51cf\u5c1145.59%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0b\u964d0.38\u4e2a\u767e\u5206\u70b9\u3002 \u8d1f\u503a\u91cd\u5927\u53d8\u5316\u65b9\u9762\uff0c\u622a\u81f32026\u5e74\u4e00\u5b63\u5ea6\u672b\uff0c\u516c\u53f8\u5e94\u4ed8\u7968\u636e\u53ca\u5e94\u4ed8\u8d26\u6b3e\u8f83\u4e0a\u5e74\u672b\u51cf\u5c113.64%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0b\u964d0.88\u4e2a\u767e\u5206\u70b9\uff1b\u5e94\u4ea4\u7a0e\u8d39\u8f83\u4e0a\u5e74\u672b\u51cf\u5c1184.26%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0b\u964d0.42\u4e2a\u767e\u5206\u70b9\uff1b\u77ed\u671f\u501f\u6b3e\u8f83\u4e0a\u5e74\u672b\u589e\u52a01540.36%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0a\u53470.3\u4e2a\u767e\u5206\u70b9\uff1b\u5408\u540c\u8d1f\u503a\u8f83\u4e0a\u5e74\u672b\u589e\u52a012.45%\uff0c\u5360\u516c\u53f8\u603b\u8d44\u4ea7\u6bd4\u91cd\u4e0a\u53470.24\u4e2a\u767e\u5206\u70b9\u3002 2026\u5e74\u7b2c\u4e00\u5b63\u5ea6\uff0c\u516c\u53f8\u6d41\u52a8\u6bd4\u7387\u4e3a2.2\uff0c\u901f\u52a8\u6bd4\u7387\u4e3a1.49\u3002 \u4e00\u5b63\u62a5\u663e\u793a\uff0c2026\u5e74\u4e00\u5b63\u5ea6\u672b\u7684\u516c\u53f8\u5341\u5927\u6d41\u901a\u80a1\u4e1c\u4e2d\uff0c\u65b0\u8fdb\u80a1\u4e1c\u4e3a\u5e7f\u53d1\u4e2d\u8bc1 \u5de5\u7a0b\u673a\u68b0 \u4e3b\u9898\u4ea4\u6613\u578b\u5f00\u653e\u5f0f\u6307\u6570\u8bc1\u5238\u6295\u8d44\u57fa\u91d1\uff0c\u53d6\u4ee3\u4e86\u4e0a\u5e74\u672b\u7684\u738b\u4e9a\u519b\u3002\u5728\u5177\u4f53\u6301\u80a1\u6bd4\u4f8b\u4e0a\uff0c\u9999\u6e2f\u4e2d\u592e\u7ed3\u7b97\u6709\u9650\u516c\u53f8\u3001 \u4e2d\u8bc1500 \u4ea4\u6613\u578b\u5f00\u653e\u5f0f\u6307\u6570\u8bc1\u5238\u6295\u8d44\u57fa\u91d1\u3001\u674e\u56fd\u98ce\u3001\u9e4f\u534e\u4e0a\u8bc1\u79d1\u521b\u677f100\u4ea4\u6613\u578b\u5f00\u653e\u5f0f\u6307\u6570\u8bc1\u5238\u6295\u8d44\u57fa\u91d1\u6301\u80a1\u6709\u6240\u4e0b\u964d\u3002 \u80a1\u4e1c\u540d\u79f0 \u6301\u6d41\u901a\u80a1\u6570(\u4e07\u80a1) \u5360\u603b\u80a1\u672c\u6bd4\u4f8b(%) \u53d8\u52a8\u6bd4\u4f8b(\u767e\u5206\u70b9) \u4e2d\u56fd\u94c1\u5efa \u80a1\u4efd\u6709\u9650\u516c\u53f8 383626.22 71.9277 \u4e0d\u53d8 \u4e2d\u56fd\u94c1\u8def \u901a\u4fe1 \u4fe1\u53f7\u96c6\u56e2\u6709\u9650\u516c\u53f8 3484.32 0.6532 \u4e0d\u53d8 \u963f\u5e03\u8fbe\u6bd4\u6295\u8d44\u5c40-\u81ea\u6709\u8d44\u91d1 2350 0.4406 \u4e0d\u53d8 \u4e2d\u56fd\u571f\u6728\u5de5\u7a0b\u96c6\u56e2\u6709\u9650\u516c\u53f8 1927.77 0.3614 \u4e0d\u53d8 \u9999\u6e2f\u4e2d\u592e\u7ed3\u7b97\u6709\u9650\u516c\u53f8 1429.28 0.2679 -0.126 \u4e2d\u8bc1500 \u4ea4\u6613\u578b\u5f00\u653e\u5f0f\u6307\u6570\u8bc1\u5238\u6295\u8d44\u57fa\u91d1 1206.92 0.2262 -0.215 \u674e\u56fd\u98ce 1036.73 0.1943 -0.008 \u9e4f\u534e\u4e0a\u8bc1\u79d1\u521b\u677f100\u4ea4\u6613\u578b\u5f00\u653e\u5f0f\u6307\u6570\u8bc1\u5238\u6295\u8d44\u57fa\u91d1 1024.37 0.192 -0.017 \u56db\u5ddd\u516c\u8def\u6865\u6881\u5efa\u8bbe\u96c6\u56e2\u6709\u9650\u516c\u53f8 871.08 0.1633 \u4e0d\u53d8 \u5e7f\u53d1\u4e2d\u8bc1 \u5de5\u7a0b\u673a\u68b0 \u4e3b\u9898\u4ea4\u6613\u578b\u5f00\u653e\u5f0f\u6307\u6570\u8bc1\u5238\u6295\u8d44\u57fa\u91d1 764.35 0.1433 \u65b0\u8fdb \u6307\u6807\u6ce8\u89e3\uff1a \u5e02\u76c8\u7387 =\u603b\u5e02\u503c/\u51c0\u5229\u6da6\u3002\u5f53\u516c\u53f8\u4e8f\u635f\u65f6\u5e02\u76c8\u7387\u4e3a\u8d1f\uff0c\u6b64\u65f6\u7528\u5e02\u76c8\u7387\u4f30\u503c\u6ca1\u6709\u5b9e\u9645\u610f\u4e49\uff0c\u5f80\u5f80\u7528\u5e02\u51c0\u7387\u6216\u5e02\u9500\u7387\u505a\u53c2\u8003\u3002 \u5e02\u51c0\u7387 =\u603b\u5e02\u503c/\u51c0\u8d44\u4ea7\u3002\u5e02\u51c0\u7387\u4f30\u503c\u6cd5\u591a\u7528\u4e8e\u76c8\u5229\u6ce2\u52a8\u8f83\u5927\u800c\u51c0\u8d44\u4ea7\u76f8\u5bf9\u7a33\u5b9a\u7684\u516c\u53f8\u3002 \u5e02\u9500\u7387 =\u603b\u5e02\u503c/\u8425\u4e1a\u6536\u5165\u3002\u5e02\u9500\u7387\u4f30\u503c\u6cd5\u901a\u5e38\u7528\u4e8e\u4e8f\u635f\u6216\u5fae\u5229\u7684\u6210\u957f\u578b\u516c\u53f8\u3002 \u6587\u4e2d\u5e02\u76c8\u7387\u548c\u5e02\u9500\u7387\u91c7\u7528TTM\u65b9\u5f0f\uff0c\u5373\u4ee5\u622a\u81f3\u6700\u8fd1\u4e00\u671f\u8d22\u62a5\uff08\u542b\u9884\u62a5\uff0912\u4e2a\u6708\u7684\u6570\u636e\u8ba1\u7b97\u3002\u5e02\u51c0\u7387\u91c7\u7528LF\u65b9\u5f0f\uff0c\u5373\u4ee5\u6700\u8fd1\u4e00\u671f\u8d22\u62a5\u6570\u636e\u8ba1\u7b97\u3002\u4e09\u8005\u7684\u5206\u4f4d\u6570\u8ba1\u7b97\u533a\u95f4\u5747\u4e3a\u516c\u53f8\u4e0a\u5e02\u4ee5\u6765\u81f3\u6700\u65b0\u516c\u544a\u65e5\u3002 \u5e02\u76c8\u7387\u3001\u5e02\u51c0\u7387\u4e3a\u8d1f\u65f6\uff0c\u4e0d\u663e\u793a\u5f53\u671f\u5206\u4f4d\u6570\uff0c\u4f1a\u5bfc\u81f4\u6298\u7ebf\u56fe\u4e2d\u65ad\u3002 \uff08\u6587\u7ae0\u6765\u6e90\uff1a\u4e2d\u56fd\u8bc1\u5238\u62a5\u00b7\u4e2d\u8bc1\u7f51\uff09 \u6587\u7ae0\u6765\u6e90\uff1a\u4e2d\u56fd\u8bc1\u5238\u62a5\u00b7\u4e2d\u8bc1\u7f51 \u8d23\u4efb\u7f16\u8f91\uff1a126 \u539f\u6807\u9898\uff1a\u94c1\u5efa\u91cd\u5de5\uff1a2026\u5e74\u4e00\u5b63\u5ea6\u51c0\u5229\u6da62.48\u4ebf\u5143 \u90d1\u91cd\u58f0\u660e\uff1a \u4e1c\u65b9\u8d22\u5bcc\u53d1\u5e03\u6b64\u5185\u5bb9\u65e8\u5728\u4f20\u64ad\u66f4\u591a\u4fe1\u606f\uff0c\u4e0e\u672c\u7ad9\u7acb\u573a\u65e0\u5173\uff0c\u4e0d\u6784\u6210\u6295\u8d44\u5efa\u8bae\u3002\u636e\u6b64\u64cd\u4f5c\uff0c\u98ce\u9669\u81ea\u62c5\u3002 \u4e3e\u62a5 \u4e1c\u65b9\u8d22\u5bcc\u7f51 \u5206\u4eab\u5230\u5fae\u4fe1\u670b\u53cb\u5708 \u6253\u5f00\u5fae\u4fe1\uff0c \u70b9\u51fb\u5e95\u90e8\u7684\u201c\u53d1\u73b0\u201d \u4f7f\u7528\u201c\u626b\u4e00\u626b\u201d \u5373\u53ef\u5c06\u7f51\u9875\u5206\u4eab\u81f3\u670b\u53cb\u5708 \u626b\u63cf\u4e8c\u7ef4\u7801\u5173\u6ce8 \u4e1c\u65b9\u8d22\u5bcc\u5b98\u7f51\u5fae\u4fe1 \u6caa\u80a1\u901a \u6df1\u80a1\u901a \u6e2f\u80a1\u901a(\u6caa) \u6e2f\u80a1\u901a(\