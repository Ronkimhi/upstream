5d3\u05d5 (\u05d5\u05d1\u05e6\u05d3\u05e7) \u05e2\u05dc \u05d4\u05de\u05d2\u05d5\u05d5\u05df \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d7\u05d9\u05d5\u05ea \u05d4\u05d1\u05e8, \u05d5\u05d2\u05dd \u05db\u05de\u05d5\u05d1\u05df \u05e2\u05dc \u05db\u05dc\u05db\u05dc\u05ea \u05de\u05e9\u05e7 \u05d4\u05d7\u05d9. \u05d5\u05d0\u05d6, \u05d4\u05e0\u05d2\u05d9\u05e3 \u05d0\u05d5\u05ea\u05ea \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d2\u05dd \u05e9\u05dd. \\7 1 1 55 10K shay fleishon \ud83e\uddec @shay_fleishon 10h \u05e7\u05d5\u05d3\u05dd 2-3 \u05e6\u05d9\u05e4\u05d5\u05e8\u05d9\u05dd \u05d1\u05d0\u05d5\u05e1\u05d8\u05e8\u05dc\u05d9\u05d4, \u05d5\u05d0\u05d6 \u05d2\u05dd \u05d8\u05d6\u05de\u05e0\u05d9\u05d4 \u05d5\u05d0\u05d7\"\u05db \u05e0\u05d9\u05d5-\u05d6\u05d9\u05dc\u05e0\u05d3. \u05d5\u05e2\u05db\u05e9\u05d9\u05d5, \u05ea\u05d5\u05da 3-4 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05db\u05d1\u05e8 \u05d9\u05e9 \u05d3\u05d9\u05d5\u05d5\u05d7 \u05e9\u05dc 498 \u05d7\u05d9\u05d5\u05ea \u05d1 6 \u05de\u05d3\u05d9\u05e0\u05d5\u05ea \u05d1\u05e8\u05d7\u05d1\u05d9 \u05d0\u05d5\u05e1\u05d8\u05e8\u05dc\u05d9\u05d4, \u05e6\u05e4\u05d5\u05df \u05d5\u05d3\u05e8\u05d5\u05dd. \u05db\u05d0\u05e9\u05e8 \u05d4\u05e0\u05d2\u05d9\u05e3 \u05d4\u05e1\u05e4\u05d9\u05e7 \u05dc\u05d6\u05dc\u05d5\u05d2 \u05e9\u05dd \u05d1\u05d6\u05de\u05df \u05e9\u05d9\u05d0 \u05dc\u05d9\u05d5\u05e0\u05e7\u05d9\u05dd \u05d1\u05d1\u05e8, \u05e9\u05d5\u05e2\u05dc\u05d9\u05dd \u05e0\u05de\u05e6\u05d0\u05d5 \u05d7\u05d5\u05dc\u05d9\u05dd, \u05d5\u05d6\u05d4 \u05e8\u05e7 \u05d4\u05d4\u05ea\u05d7\u05dc\u05d4 \u05dc\u05e6\u05e2\u05e8\u05e0\u05d5. \\8 1 2 58 9.4K shay fleishon \ud83e\uddec @shay_fleishon 10h \u05db\u05dc \u05e4\u05e2\u05dd \u05e9\u05e0\u05e8\u05d0\u05d4 \u05e9\u05d9\u05e9 \u05d3\u05e2\u05d9\u05db\u05d4, \u05d0\u05e9 \u05d4\u05de\u05d2\u05d9\u05e4\u05d4 \u05d6\u05d5\u05dc\u05d2\u05ea \u05dc\u05de\u05d9\u05e0\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05d5\u05de\u05e6\u05d9\u05ea\u05d4 \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05d4\u05de\u05d5\u05d5\u05ea \u05d5\u05d4\u05d7\u05d5\u05e8\u05d1\u05df. \u05d4\u05de\u05e7\u05e8\u05d4 \u05d4\u05db\u05d9 \u05d6\u05db\u05d5\u05e8 \u05dc\u05d9 \u05d4\u05d9\u05d4 \u05d1\u05e1\u05d5\u05e3 \u05e9\u05e0\u05d4 \u05e9\u05e2\u05d1\u05e8\u05d4 \u05d1\u05e2\u05d2\u05d5\u05e8\u05d9\u05dd \u05d0\u05e4\u05d5\u05e8\u05d9\u05dd, \u05d5\u05d4\u05d5\u05d0 \u05d4\u05d3\u05d2\u05d9\u05dd \u05d0\u05ea \u05e2\u05d5\u05de\u05e1 \u05d4\u05de\u05d2\u05d9\u05e4\u05d4 \u05d4\u05d9\u05d8\u05d1. \\9 1 2 59 8.9K shay fleishon \ud83e\uddec @shay_fleishon 10h \u05e2\u05d2\u05d5\u05e8\u05d9\u05dd \u05d0\u05e4\u05d5\u05e8\u05d9\u05dd \u05d1\u05d0\u05d9\u05e8\u05d5\u05e4\u05d4, \u05d7\u05d9\u05d9\u05dd \u05d12 \u05de\u05e1\u05dc\u05d5\u05dc\u05d9 \u05e0\u05d3\u05d9\u05d3\u05d4 \u05e2\u05d9\u05e7\u05e8\u05d9\u05d9\u05dd, \u05d4\u05de\u05e2\u05e8\u05d1\u05d9 \u05d5\u05d4\u05de\u05d6\u05e8\u05d7\u05d9. \u05d4\u05de\u05d6\u05e8\u05d7\u05d9 \u05e0\u05d3\u05d1\u05e7 \u05db\u05d1\u05e8 \u05d1\u05e9\u05dc\u05d1\u05d9\u05dd \u05de\u05d5\u05e7\u05d3\u05de\u05d9\u05dd. \u05d4\u05e2\u05d2\u05d5\u05e8\u05d9\u05dd \u05d1\u05de\u05e2\u05e8\u05d1\u05d9 \u05dc\u05e2\u05d5\u05de\u05ea \u05d6\u05d0\u05ea \u05dc\u05d0 \u05d7\u05d5\u05d5 \u05d0\u05ea\u05d4\u05de\u05d2\u05d9\u05e4\u05d4. \u05e2\u05d3 \u05e9\u05d1\u05e1\u05d5\u05e3 2025 \u05de\u05e2\u05dc 50 \u05d0\u05dc\u05e3 \u05d2\u05d5\u05e4\u05d5\u05ea \u05e2\u05d2\u05d5\u05e8\u05d9\u05dd \u05d0\u05e4\u05d5\u05e8\u05d9\u05dd \u05e0\u05d0\u05e1\u05e4\u05d5 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e4\u05e7\u05d7\u05d9\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e0\u05d3\u05d9\u05d3\u05d4 \u05d1\u05d2\u05e8\u05de\u05e0\u05d9\u05d4, \u05e6\u05e8\u05e4\u05ea \u05d5\u05e1\u05e4\u05e8\u05d3 \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4 \u05e9\u05dc \u05e4\u05d7\u05d5\u05ea \u05de\u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd(!) \\10 2 2 60 8.8K shay fleishon \ud83e\uddec @shay_fleishon 10h \u05d6\u05d4 \u05d4\u05de\u05e6\u05d1. \u05d4\u05d5\u05d0 \u05de\u05e9\u05d5\u05dd \u05de\u05d4 \u05dc\u05d0 \u05de\u05d5\u05db\u05e8 \u05dc\u05e8\u05d5\u05d1 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8. \u05d0\u05d1\u05dc \u05dc\u05d3\u05e2\u05ea\u05d9, \u05d7\u05e9\u05d5\u05d1 \u05dc\u05d4\u05db\u05d9\u05e8 \u05e9\u05d1\u05e8\u05d2\u05e2\u05d9\u05dd \u05d0\u05dc\u05d5 \u05de\u05de\u05e9 \u05de\u05ea\u05e8\u05d7\u05e9 \u05d0\u05e1\u05d5\u05df \u05d4\u05d8\u05d1\u05e2 \u05de\u05d4\u05d7\u05de\u05d5\u05e8\u05d9\u05dd \u05e9\u05d4\u05d0\u05e0\u05d5\u05e9\u05d5\u05ea \u05d4\u05d9\u05d9\u05ea\u05d4 \u05e2\u05d3\u05d4 \u05dc\u05d4\u05dd. \\11 6 6 136 9.8K Gal Haimovich \u2623 \ud83d\udd2c\ud83c\udf97 @grnfluoresceblg 8h \u05de\u05d3\u05d0\u05d9\u05d2 \u05de\u05d0\u05d5\u05d3 \u05de\u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05dd \u05d9\u05e9 \u05e2\u05d3\u05d5\u05d9\u05d5\u05ea \u05d0\u05e8\u05db\u05d9\u05d0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05dc\u05de\u05d2\u05d9\u05e4\u05d4 \u05e4\u05d0\u05df-\u05d6\u05d5\u05d0\u05d5\u05e0\u05d5\u05d8\u05d9\u05ea \u05db\u05de\u05d5 \u05e9\u05e4\u05e2\u05ea \u05e9\u05db\u05d9\u05dc\u05ea\u05d4 \u05d0\u05dc\u05e4\u05d9 \u05e4\u05e8\u05d8\u05d9\u05dd \u05de\u05e2\u05e9\u05e8\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05dd \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4 \u05e7\u05e6\u05e8\u05d4 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d0\u05d5 \u05d4\u05e4\u05e8\u05d4-\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4. \u05d0\u05d5 \u05e9\u05d6\u05d5 \u05e4\u05e2\u05dd \u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e9\u05d6\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05d1\u05d4\u05d9\u05e7\u05e3 \u05db\u05d6\u05d4 \u05dc\u05e4\u05d7\u05d5\u05ea \u05d1\u05db\u05de\u05d4 \u05d0\u05dc\u05e4\u05d9 \u05d4\u05e9\u05e0\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea. 1 6 6.4K"
