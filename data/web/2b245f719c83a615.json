 "text_sha256": "4cbc9d248a533b989fdc24ac2fa4adc216293cd06e99049e3762952f5e2c8cd2",
 "text": "\u4e5d\u6c5f\u77f3\u5316\u65b0\u88c5\u7f6e\u5f00\u5de5\u5efa\u8bbe\uff0c\u6253\u9020\u201c\u70bc\u6cb9+\u82b3\u70c3+PTA+PET+\u7ec8\u7aef\u4ea7\u54c1\u201d\u5168\u4ea7\u4e1a\u94fe - \u6700\u65b0\u8981\u95fb - PROCESS\u6d41\u7a0b\u5de5\u4e1a \u884c\u4e1a \u6d41\u7a0b\u5de5\u4e1a \u65b0\u80fd\u6e90 \u6c7d\u8f66 \u91d1\u5c5e\u52a0\u5de5 \u7269\u6d41 \u81ea\u52a8\u5316\u4e0e\u9a71\u52a8 \u5236\u836f \u5851\u6599 \u98df\u54c1\u5de5\u7a0b \u673a\u5668\u4eba \u5b9e\u9a8c\u5206\u6790 \u656c\u8bf7\u671f\u5f85...... ',{onInit(dialog){setTimeout(() => {this.close();},3000);}});return false;\">\u4f1a\u8bae \u656c\u8bf7\u671f\u5f85...... ',{onInit(dialog){setTimeout(() => {this.close();},3000);}});return false;\">\u6570\u636e --> \u89c6\u9891 \u76f4\u64ad \u656c\u8bf7\u671f\u5f85...... ',{onInit(dialog){setTimeout(() => {this.close();},3000);}});return false;\">\u8bfe\u7a0b --> \u5c55\u4f1a --> \u6b22\u8fce\u5149\u4e34\u5f17\u6208\u5de5\u4e1a\u4f20\u5a92\uff01 --> \u767b\u5f55 \u4e28 \u6ce8\u518c {nickname} \u7528\u6237\u4e2d\u5fc3 [ \u5b89\u5168\u9000\u51fa ] \u6295\u7a3f --> \u6295\u5ba1\u7a3f\u5165\u53e3 \u9996\u9875 \u6700\u65b0\u8981\u95fb \u6280\u672f\u5206\u4eab \u7535\u5b50\u6742\u5fd7 \u5de5\u4e1a\u8bfe\u5802 \u884c\u4e1a\u62a5\u544a \u89c6\u9891\u8282\u76ee \u4e13\u9898\u770b\u70b9 \u4f01\u4e1a\u98ce\u91c7 \u5173\u4e8e\u6211\u4eec \u4e5d\u6c5f\u77f3\u5316\u65b0\u88c5\u7f6e\u5f00\u5de5\u5efa\u8bbe\uff0c\u6253\u9020\u201c\u70bc\u6cb9+\u82b3\u70c3+PTA+PET+\u7ec8\u7aef\u4ea7\u54c1\u201d\u5168\u4ea7\u4e1a\u94fe \u4e2d\u56fd\u77f3\u5316\u65b0\u95fb\u7f51 --> 2025-04-08 \u5206\u4eab\u5230 --> 2025\u5e743\u670826\u65e5\uff0c\u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u52a0\u6c22\u88c2\u5316\u88c5\u7f6e\u5f00\u59cb\u6869\u57fa\u65bd\u5de5\uff0c\u8fd9\u662f\u7ee7\u8fde\u7eed\u91cd\u6574\u88c5\u7f6e\u3001\u82b3\u70c3\u8054\u5408\u88c5\u7f6e\u6869\u57fa\u65bd\u5de5\u540e\uff0c\u9879\u76ee\u7b2c\u4e09\u5957\u6838\u5fc3\u88c5\u7f6e\u5f00\u5de5\u5efa\u8bbe\uff0c\u6807\u5fd7\u7740\u9879\u76ee\u6574\u4f53\u8fdb\u5165\u52a0\u901f\u63a8\u8fdb\u671f\u3002 2025\u5e743\u670826\u65e5\uff0c\u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u52a0\u6c22\u88c2\u5316\u88c5\u7f6e\u5f00\u59cb\u6869\u57fa\u65bd\u5de5\uff0c\u8fd9\u662f\u7ee7\u8fde\u7eed\u91cd\u6574\u88c5\u7f6e\u3001\u82b3\u70c3\u8054\u5408\u88c5\u7f6e\u6869\u57fa\u65bd\u5de5\u540e\uff0c\u9879\u76ee\u7b2c\u4e09\u5957\u6838\u5fc3\u88c5\u7f6e\u5f00\u5de5\u5efa\u8bbe\uff0c\u6807\u5fd7\u7740\u9879\u76ee\u6574\u4f53\u8fdb\u5165\u52a0\u901f\u63a8\u8fdb\u671f\u3002 \u56fe\u4e3a\u4e5d\u6c5f\u77f3\u5316\u5382\u533a \u8be5\u9879\u76ee\u91c7\u7528\u4e2d\u56fd\u77f3\u5316\u81ea\u4e3b\u7814\u53d1\u6280\u672f\uff0c\u53ef\u5b9e\u73b0\u4ea7\u80fd\u63d0\u5347\u4e0e\u6c61\u67d3\u51cf\u534a\u7684\u53cc\u91cd\u76ee\u6807\uff0c\u5c06\u65b0\u5efa150\u4e07\u5428/\u5e74\u82b3\u70c3\u88c5\u7f6e\u3001200\u4e07\u5428/\u5e74\u8fde\u7eed\u91cd\u6574\u88c5\u7f6e\u3001200\u4e07\u5428/\u5e74\u52a0\u6c22\u88c2\u5316\u88c5\u7f6e\u7b49\uff0c\u4e3b\u8981\u751f\u4ea7\u8f7b\u77f3\u8111\u6cb9\u548c\u91cd\u77f3\u8111\u6cb9\u3002 \u9879\u76ee\u5efa\u6210\u6295\u4ea7\u540e\uff0c\u5c06\u52a9\u529b\u4f01\u4e1a\u6784\u5efa\u70bc\u6cb9\u82b3\u70c3\u4e00\u4f53\u5316\u53d1\u5c55\u65b0\u683c\u5c40\u3001\u6253\u9020\u201c\u70bc\u6cb9+\u82b3\u70c3+PTA+PET+\u7ec8\u7aef\u4ea7\u54c1\u201d\u5168\u4ea7\u4e1a\u94fe\u6761\uff0c\u5e26\u52a8\u6c5f\u897f\u7701\u77f3\u5316\u4ea7\u4e1a\u8f6c\u578b\u5347\u7ea7\u3002 \u8be5\u9879\u76ee\u5efa\u8bbe\u5185\u5bb9\u5305\u62ec\u65b0\u5efa150\u4e07\u5428/\u5e74\u82b3\u70c3\u88c5\u7f6e\u3001\u65b0\u5efa200\u4e07\u5428/\u5e74\u8fde\u7eed\u91cd\u6574 (\u542b\u9884\u52a0\u6c22) \u88c5\u7f6e(\u542b\u6db2\u5316\u6c14\u5206\u79bb\u5355\u5143)\u3001\u65b0\u5efa200\u4e07\u5428/\u5e74\u52a0\u6c22\u88c2\u5316\u88c5\u7f6e\u73b0\u6709\u6e23\u6cb9\u52a0\u6c22\u88c5\u7f6e\u6539\u9020\u4e3a200\u4e07\u5428/\u5e74\u7ec4\u5408\u5e8a\u6e23\u6cb9\u52a0\u6c22\u3001\u65b0\u5efa12\u4e07\u6807\u7acb/\u65f6PSA \u5236\u6c22\u88c5\u7f6e\u3001\u65b0\u5efa\u4ea7\u54c1\u7cbe\u5236\u88c5\u7f6e\u4ee5\u53ca\u65b0\u5efa7\u4e07\u5428/\u5e74\u786b\u78fa\u56de\u6536\u8054\u5408\u88c5\u7f6e,\u914d\u5957\u65b0\u5efa\u548c\u6539\u9020\u73b0\u6709\u50a8\u8fd0\u8bbe\u65bd\u548c\u516c\u7528\u5de5\u7a0b \u9879\u76ee\u603b\u6295\u8d44\uff1a1069866\u4e07\u5143,\u5176\u4e2d\u73af\u4fdd\u6295\u8d4476996.85\u4e07\u5143,\u5360\u9879\u76ee\u603b\u6295\u8d44\u76847.2%; 2024\u5e7412\u670817\u65e5\uff0c\u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u82b3\u70c3\u8054\u5408\u88c5\u7f6e\u548c\u7cfb\u7edf\u914d\u5957\u57fa\u7840\u8bbe\u8ba1\u83b7\u5f97\u6279\u590d\uff0c\u6807\u5fd7\u7740\u9879\u76ee\u7684\u57fa\u7840\u8bbe\u8ba1\u5df2\u5168\u90e8\u6279\u590d\uff0c\u5168\u9762\u8fdb\u5165\u8be6\u7ec6\u8bbe\u8ba1\u9636\u6bb5\u3002 150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u6d89\u53ca\u4e5d\u6c5f\u77f3\u5316\u8001\u5382\u533a\u5185\u591a\u4e2a\u533a\u57df\u7684\u62c6\u9664\u3001\u8fd8\u5efa\u3001\u518d\u62c6\u9664\u3001\u518d\u8fd8\u5efa\uff0c\u8f83\u4e3a\u590d\u6742\u3002 2024\u5e749\u67087\u65e5\uff0c\u9879\u76ee\u70bc\u6cb9\u88c5\u7f6e\u57fa\u7840\u8bbe\u8ba1\u6587\u4ef6\u4e0a\u62a5\u4e2d\u56fd\u77f3\u5316\u603b\u90e8\u7533\u8bf7\u5ba1\u67e5\u30029\u670819\u65e5\u81f320\u65e5\uff0c\u603b\u90e8\u5728\u5317\u4eac\u7ec4\u7ec7\u53ec\u5f00\u9879\u76ee\u70bc\u6cb9\u88c5\u7f6e\u57fa\u7840\u8bbe\u8ba1\u5ba1\u67e5\u4f1a\uff0c\u5171\u52067\u4e2a\u5c0f\u7ec4\u8fdb\u884c\u4e13\u4e1a\u5ba1\u67e5\uff0c\u5f62\u6210\u5ba1\u67e5\u610f\u89c1301\u6761\u3002\u4e3a\u5c3d\u5feb\u83b7\u5f97\u9879\u76ee\u57fa\u7840\u8bbe\u8ba1\u6279\u590d\uff0c\u4e00\u4f53\u5316\u529e\u516c\u5ba4\u968f\u5373\u7ec4\u7ec7\u8bbe\u8ba1\u9662\u73b0\u573a\u7b54\u590d\u30029\u670829\u65e5\uff0c\u9879\u76ee\u70bc\u6cb9\u88c5\u7f6e\u57fa\u7840\u8bbe\u8ba1\u83b7\u5f97\u6279\u590d\u3002 2024\u5e7410\u670824\u65e5\u81f325\u65e5\uff0c\u5728\u4e5d\u6c5f\u5f00\u5c55\u7cfb\u7edf\u914d\u5957\u57fa\u7840\u8bbe\u8ba1\u5185\u5ba1\u4f1a\uff0c\u7b54\u590d\u610f\u89c1274\u6761\u300210\u670830\u65e5\u81f331\u65e5\uff0c\u5728\u5e7f\u5dde\u5f00\u5c55\u82b3\u70c3\u8054\u5408\u88c5\u7f6e\u57fa\u7840\u8bbe\u8ba1\u5185\u5ba1\u4f1a\uff0c\u7b54\u590d\u610f\u89c1397\u6761\u300211\u670814\u81f315\u65e5\uff0c\u603b\u90e8\u5728\u5317\u4eac\u7ec4\u7ec7\u53ec\u5f00\u9879\u76ee\u82b3\u70c3\u8054\u5408\u88c5\u7f6e\u548c\u7cfb\u7edf\u914d\u5957\u57fa\u7840\u8bbe\u8ba1\u5ba1\u67e5\u4f1a\uff0c\u5f62\u6210\u610f\u89c1317\u6761\u3002 2024\u5e7412\u670817\u65e5\uff0c\u82b3\u70c3\u8054\u5408\u88c5\u7f6e\u548c\u7cfb\u7edf\u914d\u5957\u57fa\u7840\u8bbe\u8ba1\u83b7\u5f97\u6279\u590d\uff0c\u4e3a\u5168\u529b\u6253\u901a\u9879\u76ee\u5f00\u5de5\u6700\u540e\u201c\u4e00\u516c\u91cc\u201d\u521b\u9020\u4e86\u6709\u5229\u6761\u4ef6\u3002 \u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u91c7\u7528\u4e2d\u56fd\u77f3\u5316\u81ea\u4e3b\u6280\u672f\uff0c\u5efa\u6210\u540e\u5c06\u52a9\u529b\u4f01\u4e1a\u6784\u5efa\u70bc\u6cb9\u82b3\u70c3\u4e00\u4f53\u5316\u53d1\u5c55\u65b0\u683c\u5c40\u3001\u8fc8\u5411\u201c\u70bc\u6cb9+\u82b3\u70c3+PTA+PET+\u7ec8\u7aef\u4ea7\u54c1\u201d\u5168\u4ea7\u4e1a\u94fe\u53d1\u5c55\uff0c\u6709\u52a9\u4e8e\u4f01\u4e1a\u6574\u5408\u6cbf\u6c5f\u8d44\u6e90\u3001\u5b9e\u73b0\u82b3\u70c3\u4ea7\u4e1a\u94fe\u91cd\u6784\u3001\u7531\u201c\u71c3\u6599\u578b\u4f01\u4e1a\u201d\u5411\u201c\u70bc\u5316\u4e00\u4f53\u5316\u4f01\u4e1a\u201d\u8f6c\u578b\u5347\u7ea7\uff0c\u52a9\u529b\u6253\u9020\u6c5f\u897f\u7701\u5343\u4ebf\u5143\u7ea7\u5316\u5de5\u56ed\u533a\u548c\u4e2d\u90e8\u5730\u533a\u4e00\u6d41\u7eff\u8272\u667a\u80fd\u77f3\u6cb9\u70bc\u5316\u57fa\u5730\u3002 \u6587\u7ae0\u5185\u5bb9\u6765\u6e90\u4e2d\u56fd\u77f3\u5316\u65b0\u95fb\u7f51\uff0c\u6d41\u7a0b\u5de5\u4e1a\u6574\u7406\u7f16\u8f91\uff0c\u8d23\u4efb\u7f16\u8f91\uff1a\u80e1\u9759\uff0c\u5ba1\u6838\u4eba\uff1a\u674e\u5ce5 \u7248\u6743\u58f0\u660e\u2236\u8f6c\u8f7d\u6d41\u7a0b\u5de5\u4e1a\u7f51\u5185\u5bb9\uff0c\u8bf7\u5728\u6b63\u6587\u4e0a\u65b9\u6ce8\u660e\u6765\u6e90\u548c\u4f5c\u8005\uff0c\u4e14\u4e0d\u5f97\u5bf9\u5185\u5bb9\u4f5c\u5b9e\u8d28\u6027\u6539\u52a8\uff1b\u5fae\u4fe1\u516c\u4f17\u53f7\u3001\u5934\u6761\u53f7\u7b49\u65b0\u5a92\u4f53\u5e73\u53f0\uff0c\u8f6c\u8f7d\u8bf7\u8054\u7cfb\u6388\u6743\u3002\u90ae\u7bb1\u2236process@vogel.com.cn\uff0c\u7535\u8bdd\uff1a16601379371\uff08\u540c\u5fae\u4fe1\uff09 \u4e0a\u4e00\u7bc7 \u4e0b\u4e00\u7bc7 \u76f8\u5173\u63a8\u8350 \u4e2d\u56fd\u5316\u5b66\u5929\u8fb0\u516c\u53f8\u603b\u627f\u5305\u7684\u798f\u5efa\u4e2d\u6c99\u53e4\u96f7\u9879\u76eePC&BPA\u8054\u5408\u88c5\u7f6e\u9996\u5854\u540a\u88c5\u5706\u6ee1\u5b8c\u6210\uff01 \u8fd1\u65e5\uff0c\u4e2d\u56fd\u5316\u5b66\u5929\u8fb0\u516c\u53f8\u603b\u627f\u5305\u7684\u798f\u5efa\u4e2d\u6c99\u53e4\u96f7\u9879\u76eePC&BPA\u8054\u5408\u88c5\u7f6e\u8fce\u6765\u91cd\u8981\u91cc\u7a0b\u7891\u8282\u70b9\u3002 MORE --> 2025-04-03 \u4e2d\u56fd\u5316\u5b66\u5929\u8fb0\u516c\u53f8 0 --> \u4e2d\u56fd\u5316\u5b66\u5929\u8fb0\u516c\u53f8 CHINAPLAS 2025\uff1aCellasto\u00ae \u4e0e\u5965\u7d22\u5408\u4f5c\u63d0\u5347\u5047\u80a2\u6027\u80fd \u5965\u7d22\u7684\u66b4\u98ce\u98de\u6bdb\u817f\u00ae\u201c\u5927\u5730\u201d\u5047\u80a2\u811a\u677f\u4f7f\u7528\u5df4\u65af\u592b Cellasto\u00ae \u5fae\u5b54\u6750\u6599\uff0c\u4ee5\u589e\u5f3a\u67d4\u6027\u3001\u97e7\u6027\u548c\u80fd\u91cf\u8fd4\u8fd8\uff0c\u4f7f\u5047\u80a2\u811a\u677f\u6a21\u4eff\u4eba\u7c7b\u808c\u8089\u808c\u8171\u8fd0\u52a8\uff1bCellasto\u00ae \u7684\u6ce1\u6cab\u8bbe\u8ba1\u65e0\u9700\u673a\u68b0\u8c03\u6574\u5373\u53ef\u9002\u5e94\u5404\u79cd\u884c\u8d70\u6761\u4ef6\uff0c\u901a\u8fc7\u4e25\u683c\u7684\u6d4b\u8bd5\u548c\u4ee5\u7528\u6237\u4e3a\u4e2d\u5fc3\u7684\u7814\u53d1\uff0c\u786e\u4fdd\u7a33\u5065\u7684\u6027\u80fd\uff1b\u5df4\u65