 "text_sha256": "84a84435d4fe31e65605e69b7809b6a49a14621b821fcce716fe00aa15da346c",
 "text": "\u603b\u6295\u8d44102.9\u4ebf\uff01\u6c5f\u897f\u8fd9\u4e2a150\u4e07\u5428/\u5e74PX\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u6709\u65b0\u8fdb\u5c55 - \u6700\u65b0\u8981\u95fb - PROCESS\u6d41\u7a0b\u5de5\u4e1a \u884c\u4e1a \u6d41\u7a0b\u5de5\u4e1a \u65b0\u80fd\u6e90 \u6c7d\u8f66 \u91d1\u5c5e\u52a0\u5de5 \u7269\u6d41 \u81ea\u52a8\u5316\u4e0e\u9a71\u52a8 \u5236\u836f \u5851\u6599 \u98df\u54c1\u5de5\u7a0b \u673a\u5668\u4eba \u5b9e\u9a8c\u5206\u6790 \u656c\u8bf7\u671f\u5f85...... ',{onInit(dialog){setTimeout(() => {this.close();},3000);}});return false;\">\u4f1a\u8bae \u656c\u8bf7\u671f\u5f85...... ',{onInit(dialog){setTimeout(() => {this.close();},3000);}});return false;\">\u6570\u636e --> \u89c6\u9891 \u76f4\u64ad \u656c\u8bf7\u671f\u5f85...... ',{onInit(dialog){setTimeout(() => {this.close();},3000);}});return false;\">\u8bfe\u7a0b --> \u5c55\u4f1a --> \u6b22\u8fce\u5149\u4e34\u5f17\u6208\u5de5\u4e1a\u4f20\u5a92\uff01 --> \u767b\u5f55 \u4e28 \u6ce8\u518c {nickname} \u7528\u6237\u4e2d\u5fc3 [ \u5b89\u5168\u9000\u51fa ] \u6295\u7a3f --> \u6295\u5ba1\u7a3f\u5165\u53e3 \u9996\u9875 \u6700\u65b0\u8981\u95fb \u6280\u672f\u5206\u4eab \u7535\u5b50\u6742\u5fd7 \u5de5\u4e1a\u8bfe\u5802 \u884c\u4e1a\u62a5\u544a \u89c6\u9891\u8282\u76ee \u4e13\u9898\u770b\u70b9 \u4f01\u4e1a\u98ce\u91c7 \u5173\u4e8e\u6211\u4eec \u603b\u6295\u8d44102.9\u4ebf\uff01\u6c5f\u897f\u8fd9\u4e2a150\u4e07\u5428/\u5e74PX\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u6709\u65b0\u8fdb\u5c55 \u5316\u7ea4\u5934\u6761 --> 2024-12-02 \u5206\u4eab\u5230 --> \u4e5d\u6c5f\u77f3\u5316\u4f5c\u4e3a\u6c5f\u897f\u552f\u4e00\u7684\u5927\u578b\u56fd\u6709\u77f3\u6cb9\u5316\u5de5\u4f01\u4e1a\uff0c\u4e5f\u81f4\u529b\u4e8e\u70bc\u5316\u4e00\u4f53\u5316\u9879\u76ee\u7684\u5efa\u8bbe\u4e0e\u805a\u916f\u5168\u4ea7\u4e1a\u94fe\u7684\u6253\u9020\u3002\u76ee\u524d\uff0c\u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u6b63\u7d27\u9523\u5bc6\u9f13\u63a8\u8fdb\uff0c\u65b0\u5efa\u88c5\u7f6e\u5747\u91c7\u7528\u4e2d\u56fd\u77f3\u5316\u81ea\u4e3b\u6280\u672f\uff0c\u5c06\u6784\u5efa\u70bc\u6cb9\u82b3\u70c3\u4e00\u4f53\u5316\u53d1\u5c55\u65b0\u683c\u5c40\uff0c\u4e3a\u4f01\u4e1a\u53d1\u5c55\u6ce8\u5165\u5f3a\u52b2\u52a8\u529b\u3002 11\u670819\u65e5\uff0c\u4e2d\u56fd\u77f3\u5316\u4e5d\u6c5f\u77f3\u5316\u516c\u53f8\u5728\u77f3\u5316\u5927\u53a6\u591a\u529f\u80fd\u4f1a\u8bae\u5ba4\u53ec\u5f00\u76d1\u7763\u59d4\u5458\u4f1a\u8054\u5e2d\u4f1a\u8bae\u66a8150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u76d1\u7763\u5de5\u4f5c\u542f\u52a8\u4f1a\u3002 \u4e5d\u6c5f\u77f3\u5316\u4f5c\u4e3a\u6c5f\u897f\u552f\u4e00\u7684\u5927\u578b\u56fd\u6709\u77f3\u6cb9\u5316\u5de5\u4f01\u4e1a\uff0c\u4e5f\u81f4\u529b\u4e8e\u70bc\u5316\u4e00\u4f53\u5316\u9879\u76ee\u7684\u5efa\u8bbe\u4e0e\u805a\u916f\u5168\u4ea7\u4e1a\u94fe\u7684\u6253\u9020\u3002\u76ee\u524d\uff0c\u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u6b63\u7d27\u9523\u5bc6\u9f13\u63a8\u8fdb\uff0c\u65b0\u5efa\u88c5\u7f6e\u5747\u91c7\u7528\u4e2d\u56fd\u77f3\u5316\u81ea\u4e3b\u6280\u672f\uff0c\u5c06\u6784\u5efa\u70bc\u6cb9\u82b3\u70c3\u4e00\u4f53\u5316\u53d1\u5c55\u65b0\u683c\u5c40\uff0c\u4e3a\u4f01\u4e1a\u53d1\u5c55\u6ce8\u5165\u5f3a\u52b2\u52a8\u529b\u3002 11\u670819\u65e5\uff0c\u4e2d\u56fd\u77f3\u5316\u4e5d\u6c5f\u77f3\u5316\u516c\u53f8\u5728\u77f3\u5316\u5927\u53a6\u591a\u529f\u80fd\u4f1a\u8bae\u5ba4\u53ec\u5f00\u76d1\u7763\u59d4\u5458\u4f1a\u8054\u5e2d\u4f1a\u8bae\u66a8150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u76d1\u7763\u5de5\u4f5c\u542f\u52a8\u4f1a\u3002\u5206\u516c\u53f8\u4ee3\u8868\u3001\u603b\u5382\u515a\u59d4\u4e66\u8bb0\u8c22\u9053\u96c4\u4e3b\u6301\u4f1a\u8bae\u5e76\u8bb2\u8bdd\uff0c\u516c\u53f8\u9886\u5bfc\u8521\u667a\u3001\u5468\u8363\u3001\u8521\u57f9\u6e90\u3001\u4e01\u7406\u51fa\u5e2d\u4f1a\u8bae\u3002 \u4f1a\u8bae\u6307\u51fa\uff0c\u5f00\u5c55150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u76d1\u7763\u5de5\u4f5c\uff0c\u662f\u843d\u5b9e\u96c6\u56e2\u516c\u53f8\u91cd\u70b9\u5de5\u7a0b\u9879\u76ee\u4e13\u9879\u7763\u67e5\u8981\u6c42\uff0c\u8981\u8fd0\u7528\u201c\u5168\u5468\u671f\u7ba1\u7406\u201d\u7406\u5ff5\uff0c\u6309\u7167\u201c\u7acb\u9879\u3001\u5b9e\u65bd\u3001\u8bc4\u4f30\u201d\u7684\u63a8\u8fdb\u7a0b\u5e8f\uff0c\u4ee5\u201c\u9879\u76ee\u5316\u5b9e\u65bd\u3001\u6e05\u5355\u5316\u7ba1\u7406\u3001\u534f\u540c\u5316\u63a8\u8fdb\u3001\u5e38\u6001\u5316\u76d1\u7763\u201d\u7684\u65b9\u5f0f\u63a8\u8fdb\u9879\u76ee\u5316\u76d1\u7763\uff0c\u5168\u529b\u63a8\u8fdb150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u9ad8\u8d28\u91cf\u6253\u9020\u540c\u7c7b\u578b\u9879\u76ee\u7684\u6807\u6746\u5de5\u7a0b\u3001\u56fd\u4f18\u91d1\u5956\u5de5\u7a0b\u3002 \u4e0e\u6b64\u540c\u65f6\uff0c\u8fd1\u65e5\u4e5d\u6c5f\u77f3\u5316\u56fd\u4ea7\u5316LIMS\u7cfb\u7edf\u6210\u529f\u901a\u8fc7\u9a8c\u6536\uff0c\u6807\u5fd7\u8be5\u516c\u53f8\u4fe1\u606f\u5316\u7cfb\u7edf\u5411\u81ea\u4e3b\u53ef\u63a7\u7684\u4fe1\u521b\u56fd\u4ea7\u5316\u6539\u9020\u8fc8\u51fa\u575a\u5b9e\u6b65\u4f10\u3002\u622a\u81f311\u670821\u65e5\uff0c\u8be5\u7cfb\u7edf\u5df2\u7a33\u5b9a\u8fd0\u884c\u4e24\u5468\uff0c\u6570\u636e\u5b89\u5168\u53ef\u63a7\uff0c\u8fbe\u5230\u4e86\u9884\u671f\u6548\u679c\u3002 \u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee \u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\uff0c\u7531150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u548c\u82b3\u70c3\u4ea7\u4e1a\u94fe\u4e24\u4e2a\u90e8\u5206\u7ec4\u6210\uff0c\u8be5\u9879\u76ee\u603b\u6295\u8d44102.9\u4ebf\u5143\uff0c\u65b0\u5efa\u88c5\u7f6e\u91c7\u7528\u4e2d\u56fd\u77f3\u5316\u81ea\u4e3b\u6280\u672f\u3002\u9879\u76ee\u5efa\u6210\u540e\uff0c\u5c06\u5b9e\u73b0\u70bc\u6cb9+\u82b3\u70c3+PTA+PET+\u7ec8\u7aef\u4ea7\u54c1\u7684\u5168\u4ea7\u4e1a\u94fe\u53d1\u5c55\uff0c\u5c06\u4fc3\u8fdb\u4e5d\u6c5f\u5e02\u4ea7\u4e1a\u4f18\u5316\u5347\u7ea7\uff0c\u5e26\u52a8\u6c5f\u897f\u7701\u77f3\u5316\u4ea7\u4e1a\u8f6c\u578b\u5347\u7ea7\u3002 2022\u5e744\u670821\u65e5\u30017\u67085\u65e5\u30018\u670823\u65e5\uff0c\u4e2d\u56fd\u77f3\u5316\u96c6\u56e2\u53d1\u5c55\u8ba1\u5212\u90e8\u4e09\u6b21\u7ec4\u7ec7\u53ec\u5f00\u4e5d\u6c5f\u77f3\u5316\u70bc\u6cb9\u82b3\u70c3\u4e00\u4f53\u5316\u9879\u76ee\u9884\u53ef\u7814\u62a5\u544a\u53ca\u4e8c\u671f\u82b3\u70c3\u9879\u76ee\u4e13\u9898\u89c6\u9891\u4f1a\uff0c\u5bf9\u9879\u76ee\u524d\u671f\u5404\u9879\u5de5\u4f5c\u7ed9\u4e88\u5145\u5206\u80af\u5b9a\uff0c\u7814\u7a76\u8ba4\u4e3a\u5efa\u8bbe300\u4e07\u5428/\u5e74\u52a0\u6c22\u88c2\u5316\u3001260\u4e07\u5428/\u5e74\u8fde\u7eed\u91cd\u6574\u53ca150\u4e07\u5428/\u5e74\u82b3\u70c3\u7b49\u88c5\u7f6e\u53ef\u5b9e\u73b0\u6295\u8d44\u6700\u7701\u3001\u6548\u76ca\u6700\u4f18\uff0c\u603b\u4f53\u65b9\u6848\u53ef\u884c\uff0c\u540c\u610f\u4ee5\u6b64\u5f00\u5c55\u53ef\u884c\u6027\u7814\u7a76\u62a5\u544a\u7f16\u5236\u5de5\u4f5c\u3002 \u5728\u5404\u65b9\u7684\u5927\u529b\u652f\u6301\u4e0b\uff0c\u4e5d\u6c5f\u77f3\u5316\u4e5f\u52a0\u5feb\u4e86\u594b\u8fdb\u7684\u811a\u6b65\u30022022\u5e744\u670826\u65e5\uff0c\u4e5d\u6c5f\u77f3\u5316\u6210\u7acb\u70bc\u5316\u4e00\u4f53\u5316\u9879\u76ee\u9886\u5bfc\u5c0f\u7ec4\uff0c\u5e76\u4e8e5\u670812\u65e5\u6210\u7acb\u70bc\u5316\u4e00\u4f53\u5316\u9879\u76ee\u529e\u516c\u5ba4\uff0c\u79ef\u6781\u63a8\u8fdb\u53ef\u7814\u62a5\u544a\u7684\u7f16\u5236\u548c\u4e0a\u62a5\u7b49\u5de5\u4f5c\u30022022\u5e7411\u670818\u65e5\uff0c\u7b2c\u4e00\u7248\u53ef\u884c\u6027\u7814\u7a76\u62a5\u544a\u4e0a\u62a5\u3002 2023\u5e747\u670817\u65e5\uff0c\u82b3\u70c3\u6280\u672f\u65b9\u6848\u8bba\u8bc1\u4f1a\u53ca\u5de5\u827a\u5305\u8bc4\u5ba1\u542f\u52a8\uff1b8\u670818\u65e5\uff0c\u70bc\u6cb9\u90e8\u5206\u6280\u672f\u8bba\u8bc1\u4f1a\u53ec\u5f00\uff0c\u5bf9\u70bc\u6cb9\u5de5\u827a\u65b9\u6848\u8fdb\u884c\u4e86\u8ba8\u8bba\u4e0e\u660e\u786e\uff1b8\u670828\u65e5\uff0c\u9879\u76ee\u8fdb\u884c\u7efc\u5408\u8bba\u8bc1\uff0c\u4ece\u539f\u6599\u3001\u5de5\u827a\u3001\u6295\u8d44\u3001\u5b89\u5168\u73af\u4fdd\u3001\u7535\u6c14\u4eea\u8868\u3001\u603b\u5e73\u9762\u53ca\u50a8\u8fd0\u7b49\u5168\u65b9\u9762\u8fdb\u884c\u4e86\u6df1\u5165\u7ec6\u81f4\u7684\u8ba8\u8bba\u5206\u6790\uff1b8\u670831\u65e5\uff0c\u6280\u672f\u8ba8\u8bba\u4f1a\u518d\u6b21\u53ec\u5f00\uff0c\u5bf9\u82b3\u70c3\u6280\u672f\u65b9\u6848\u8fdb\u884c\u4e86\u5168\u65b9\u9762\u7684\u5bf9\u6bd4\u5206\u6790\uff1b10\u670819\u65e5\uff0c\u603b\u90e8\u5c31\u82b3\u70c3\u6280\u672f\u8def\u7ebf\u9009\u62e9\u518d\u6b21\u8fdb\u884c\u4f1a\u8bae\u5bf9\u63a5\uff0c\u63d0\u51fa\u6280\u672f\u8bba\u8bc1\u610f\u89c1\u3002 2023\u5e7410\u670820\u65e5\uff0c\u9879\u76ee\u987a\u5229\u901a\u8fc7\u603b\u88c1\u4f1a\uff1b10\u670823\u65e5\uff0c\u9879\u76ee\u901a\u8fc7\u96c6\u56e2\u516c\u53f8\u515a\u7ec4\u4f1a\u51b3\u8bae\uff1b10\u670826\u65e5\uff0c\u9879\u76ee\u901a\u8fc7\u96c6\u56e2\u516c\u53f8\u5916\u90e8\u8463\u4e8b\u89c1\u9762\u4f1a\uff1b10\u670831\u65e5\uff0c\u9879\u76ee\u6b63\u5f0f\u901a\u8fc7\u96c6\u56e2\u516c\u53f8\u8463\u4e8b\u4f1a\uff0c\u53d6\u5f97\u5b9e\u8d28\u6027\u8fdb\u5c55\uff0c\u6b63\u5f0f\u901a\u8fc7\u6240\u6709\u524d\u671f\u8bba\u8bc1\u53ca\u96c6\u56e2\u516c\u53f8\u5404\u9879\u9ad8\u5c42\u51b3\u8bae\uff1b11\u67086\u65e5\uff0c\u9879\u76ee\u53ef\u7814\u62a5\u544a\u83b7\u5f97\u6b63\u5f0f\u6279\u6587\u3002 2024\u5e742\u670827\u65e5\uff0c\u4e2d\u56fd\u77f3\u5316\u4e5d\u6c5f\u5206\u516c\u53f8\u5e74\u4ea7150\u4e07\u5428\u82b3\u70c3\u53ca\u70bc\u6cb9\u914d\u5957\u6539\u9020\u9879\u76ee\u63a8\u8fdb\u4f1a\u4e3e\u884c\u3002 2024\u5e749\u670826\u65e5\uff0c\u4e5d\u6c5f\u77f3\u5316150\u4e07\u5428/\u5e74\u82b3\u70c3\u53ca\u70bc\u6cb9\u6539\u9020\u9879\u76ee\u7ba1\u7406\u90e8\u96c6\u4e2d\u529e\u516c\u4e34\u8bbe\u6b63\u5f0f\u542f\u7528\u3002 \u52a0\u5feb\u7eff\u8272\u8f6c\u578b \u6253\u9020\u667a\u80fd\u5236\u9020\u6807\u6746 \u4e2d\u77f3\u5316\u4e5d\u6c5f\u5206\u516c\u53f8\u96b6\u5c5e\u4e2d\u56fd\u77f3\u5316\uff0c1980\u5e7410\u6708\u5efa\u6210\u6295\u4ea7\uff0c\u662f\u6211\u56fd\u4e2d\u90e8\u5730\u533a\u548c\u957f\u6c5f\u6d41\u57df\u91cd\u70b9\u70bc\u5316\u4f01\u4e1a\u3001\u6c5f\u897f\u7701\u552f\u4e00\u7684\u5927\u578b\u77f3\u6cb9\u5316\u5de5\u4f01\u4e1a\u3002\u516c\u53f8\u5750\u843d\u5728\u5e90\u5c71\u811a\u4e0b\u3001\u957f\u6c5f\u4e4b\u6ee8\u3001\u9131\u9633\u6e56\u7554\uff0c\u5360\u5730\u9762\u79ef4.08\u5e73\u65b9\u516c\u91cc\u3002\u4e5d\u6c5f\u77f3\u5316\u62e5\u6709\u539f\u6cb9\u52a0\u5de5\u80fd\u529b1000\u4e07\u5428\u7684\u70bc\u6cb9\u88c5\u7f6e\uff0c10\u4e07\u5428\u7164\u5236\u6c22\u88c5\u7f6e\u300189\u4e07\u5428\u82b3\u70c3\u8054\u5408\u88c5\u7f6e\u300110\u4e07\u5428\u805a\u4e19\u70ef\u30018\u4e07\u5428\u4e59\u82ef-\u82ef\u4e59\u70ef\u7b49\u4e3b\u8981\u751f\u4ea7\u88c5\u7f6e50\u4f59\u5957\u3002 \u201c\u5341\u4e09\u4e94\u201d\u671f\u95f4\uff0c\u4e5d\u6c5f\u77f3\u5316\u52a0\u5de5\u603b\u91cf\u540c\u6bd4\u589e\u52a050%\u4ee5\u4e0a\uff0c\u6c61\u67d3\u7269\u6392\u653e\u603b\u91cf\u5e73\u5747\u4e0b\u964d\u8d8570%\uff0c\u5b9e\u73b0\u589e\u4ea7\u51cf\u6c61\u3002\u5148\u540e\u83b7\u5f97\u5de5\u4fe1\u90e8\u9996\u6279\u201c\u7eff\u8272\u5de5\u5382\u201d\uff0c\u77f3\u6cb9\u548c\u5316\u5de5\u884c\u4e1a\u9996\u6279\u201c\u7eff\u8272\u5de5\u5382\u201d\uff0c\u6c5f\u897f\u7701\u751f\u6001\u6587\u660e\u5efa\u8bbe\u5148\u8fdb\u96c6\u4f53\u3001\u51cf\u6c61\u964d\u78b3\u534f\u540c\u589e\u6548\u8bd5\u70b9\u5355\u4f4d\uff0c\u8fde\u7eed\u4e03\u5e74\u83b7\u8bc4\u4e2d\u56fd\u77f3\u5316\u201c\u73af\u4fdd\u5148\u8fdb\u5355\u4f4d\u201d\u3001\u7eff\u8272\u4f01\u4e1aA\u6863\uff0c2023\u5e74\u83b7\u8bc4\u96c6\u56e2\u516c\u53f8A\u7ea7\u65e0\u5e9f\u4f01\u4e1a\u3001\u4e5d\u6c5f\u5e02\u65e0\u5e9f\u5de5\u5382\u3001\u80fd\u6548\u201c\u9886\u8dd1\u8005\u201d\u6807\u6746\u4f01\u4e1a\u3002 \u6587\u7ae0\u5185\u5bb9\u6765\u6e90\u5316\u7ea4\u5934